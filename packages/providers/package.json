  "dependencies": {
    "@assemblyscript/loader": "catalog:providers",
    "@kunai/core": "workspace:*",
    "@kunai/types": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }

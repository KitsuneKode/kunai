{
  "name": "@kunai/providers",
  "version": "0.1.0",
  "private": true,
  "description": "Kunai provider modules behind the Provider SDK boundary.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./experimental": "./src/experimental.ts",
    "./production": "./src/production.ts",
    "./production-modules": "./src/production-modules.ts",
    "./research": "./src/research.ts",
    "./allmanga": "./src/allmanga/direct.ts",
    "./allmanga/crypto": "./src/allmanga/crypto.ts",
    "./anidb": "./src/anidb/direct.ts",
    "./hianime": "./src/hianime/direct.ts",
    "./animegg": "./src/animegg/direct.ts",
    "./kickassanime": "./src/kickassanime/direct.ts",
    "./miruro": "./src/miruro/direct.ts",
    "./rivestream": "./src/rivestream/direct.ts",
    "./videasy": "./src/videasy/index.ts",
    "./vidlink": "./src/vidlink/direct.ts",
    "./movy": "./src/movy/direct.ts",
    "./vidrock": "./src/vidrock/direct.ts",
    "./youtube": "./src/youtube/index.ts"
  },
  "scripts": {
    "typecheck": "bun tsc --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "bun test test",
    "test:file": "bun test"

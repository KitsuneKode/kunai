{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "builtin": true,
    "node": true,
    "browser": true,
    "es2026": true
  },
  "plugins": ["eslint", "typescript", "import", "unicorn", "promise", "node", "react", "jsx-a11y"],

  "jsPlugins": [{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",

    "no-debugger": "error",
    "no-console": "off",

    "curly": "off",
    "eqeqeq": "warn",

    "no-await-in-loop": "off",
    "no-underscore-dangle": "off",

    "eslint/no-unused-vars": "off",
    "typescript/no-unused-vars": "warn",

    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",

    "import/no-cycle": "warn",
    "promise/no-return-wrap": "warn",

    "react/react-in-jsx-scope": "off",
    "unicorn/prefer-node-protocol": "warn",
    "unicorn/no-array-for-each": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/consistent-function-scoping": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "**/*.test.tsx", "**/*.spec.tsx", "**/test/**", "**/__mocks__/**"],
      "env": {
        "vitest": true
      },
      "rules": {
        "anti-slop/no-chained-type-assertions": "off",
        "anti-slop/no-object-parameters": "off",
        "anti-slop/no-reflect-apply": "off",
        "anti-slop/no-reflect-get": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      "files": ["**/*.config.ts", "**/*.config.js", "scripts/**"],
      "rules": {
        "no-console": "off",
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": [
        "packages/providers/**",
        "apps/cli/src/services/providers/**",
        "apps/cli/src/scraper.ts",
        "apps/cli/src/search.ts",
        "apps/cli/src/tmdb.ts"
      ],
      "rules": {
        "no-await-in-loop": "off",
        "typescript/no-explicit-any": "warn",
        "typescript/no-non-null-assertion": "warn"
      }
    }
  ],
  "ignorePatterns": [
    ".reference/experiments/**",
    "apps/cli/dist/**",
    "dist/**",
    "node_modules/**",

    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",

    ".git/**",
    ".turbo/**",
    ".next/**",
    ".cache/**",
    "coverage/**",

    "bun.lock",
    "pnpm-lock.yaml",
    "package-lock.json",
    "yarn.lock",

    "**/*.min.js",
    "**/*.d.ts"
  ]
}

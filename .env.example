# Optional CLI environment overrides (not an exhaustive list).
# Uncomment only what you need; never commit real keys or tokens.
# For installed binaries, export variables in the launching shell.

# RSS memory guard cap in MiB; default 3072.
# KUNAI_MEM_CAP_MB=3072

# Set to 1 to disable the memory safety guard; leave unset for protection.
# KUNAI_NO_MEMORY_GUARD=1

# Release metadata endpoint; defaults to Kunai's latest GitHub release API.
# KUNAI_RELEASES_API=https://api.github.com/repos/KitsuneKode/kunai/releases/latest

# Experimental playlist-sharing feature flag; off by default, 1 enables it.
# KUNAI_PLAYLIST_SHARING=1

# Set to 1 or true to block external URL opening and file-manager reveals.
# KUNAI_DISABLE_EXTERNAL_URL=1

# Any non-empty value makes Sakura animations static; unset it entirely to restore motion.
# The shell also honors NO_MOTION alongside this variable.
# KUNAI_REDUCED_MOTION=1

# Override the built-in AniList application ID; also requires its registered redirect URI.
# KUNAI_ANILIST_CLIENT_ID=

# Registered loopback callback for your AniList application override.
# KUNAI_ANILIST_REDIRECT_URI=

# Override the built-in TMDB application key used for TMDB Connect.
# KUNAI_TMDB_API_KEY=

# Your metadata-only provider relay origin; overrides providerRelay.baseUrl, unset by default.
# KUNAI_RELAY_BASE_URL=

# Bearer token for your relay; overrides providerRelay.token.
# KUNAI_RELAY_TOKEN=

+  countByStatus(status: DownloadJobStatus): number {
+    const row = this.db
+      .query<{ n: number }, [DownloadJobStatus]>(
+        "SELECT COUNT(*) AS n FROM download_jobs WHERE status = ?",
+      )
+      .get(status);
+    return row?.n ?? 0;
+  }
+
+  /** Every job in the table regardless of status — badge totals, not views. */
+  countAll(): number {

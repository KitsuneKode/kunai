{
  "$schema": "https://v2-10-0.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["test:unit", "test:integration"],
      "cache": false,
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!docs/**",
        "!test/integration/**",
        "!test/live/**",
        "!test/vhs/**",
        "!test/docker/**",
        "!test/__captures__/**",
        "!test/templates/**",
        "!CHANGELOG.md",
        "!README.md",
        "!.npmignore"
      ],
      "outputs": []
    },
    // Depends on `build` because two integration tests spawn a real build into
    // the shared `dist/`: release-build.test.ts and npm-pack-guard.test.ts.
    // Without the edge, Turbo may run the build task -- or restore its cached
    // dist/ outputs -- at the same time, and a test asserting on empty stderr
    // or a file's contents sees torn state. It then fails naming a test
    // unrelated to the change under review.
    "test:integration": {
      "dependsOn": ["transit", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!docs/**",
        "!test/unit/**",
        "!test/live/**",
        "!test/vhs/**",
        "!test/docker/**",
        "!test/__captures__/**",
        "!test/templates/**",
        "!CHANGELOG.md",
        "!README.md",
        "!.npmignore"
      ],
      "outputs": []
    }
  }
}

{
  "regions": ["iad1"],
  "rewrites": [
    {
      "source": "/metrics/daily.json",
      "destination": "/api/metrics/daily"
    },
    {
      "source": "/metrics/series.json",
      "destination": "/api/metrics/series"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/snapshot",
      "schedule": "5 0 * * *"
    }
  ],
  "functions": {
    "api/ping.ts": {
      "maxDuration": 5
    },
    "api/cron/snapshot.ts": {
      "maxDuration": 10
    },
    "api/metrics/daily.ts": {
      "maxDuration": 5
    },
    "api/metrics/admin.ts": {
      "maxDuration": 10
    },
    "api/metrics/series.ts": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/ping",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}

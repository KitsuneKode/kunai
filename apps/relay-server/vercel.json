{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "bun run vercel:bundle-api",
  "regions": ["iad1"],
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/rpc/:providerId", "destination": "/api/rpc/:providerId" }
  ],
  "functions": {
    "api/rpc/[providerId].js": {
      "maxDuration": 30
    },
    "api/health.js": {
      "maxDuration": 5
    }
  }
}

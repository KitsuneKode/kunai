{
  "name": "@kunai/relay-server",
  "private": true,
  "description": "Deployable user-owned Kunai provider RPC relay.",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev-server.ts",
    "build": "bun tsc --noEmit",
    "typecheck": "bun tsc --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "bun test test",
    "vercel:bundle-api": "bun run scripts/bundle-api.ts",
    "vercel:build": "vercel build --yes",
    "vercel:build:prod": "vercel build --prod --yes",
    "verify:deploy": "bun run scripts/verify-relay-deploy.ts"
  },
  "dependencies": {
    "@kunai/providers": "workspace:*",
    "@kunai/relay": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "5.9.3"
  }
}

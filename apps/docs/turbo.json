{
  "$schema": "https://v2-10-0.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/install.sh",
        "$TURBO_ROOT$/install.ps1",
        "$TURBO_ROOT$/scripts/packaging/render-installers.ts",
        "$TURBO_ROOT$/apps/cli/src/services/update/release-key.json",
        "$TURBO_ROOT$/.release/*.json"
      ],
      "outputs": [
        "lib/generated-metadata.json",
        "lib/generated-release-notes.json",
        "lib/generated-troubleshooting-faq.json",
        "lib/generated-mascot.json",
        "public/install.sh",
        "public/install.ps1",
        ".source/**"
      ]
    },
    "typecheck:app": {
      "dependsOn": ["generate"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["generate", "typecheck:app"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^typecheck", "generate", "typecheck:app"],
      "env": ["$TURBO_EXTENDS$", "BUN_INSTALL_CACHE_DIR"],
      "outputs": [".next/**", "!.next/cache/**"]
    }
  }
}
